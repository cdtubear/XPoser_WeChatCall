<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航：首页 / 日志 / 设置 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tab_bar_height"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="12dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tab_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_home_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_home"
            android:src="@drawable/ic_tab_home"
            android:tint="@color/primary" />

        <TextView
            android:id="@+id/tab_home_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_home"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_log"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_log_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_log"
            android:src="@drawable/ic_tab_log"
            android:tint="@color/text_hint" />

        <TextView
            android:id="@+id/tab_log_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_log"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_settings_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/tab_settings"
            android:src="@drawable/ic_tab_settings"
            android:tint="@color/text_hint" />

        <TextView
            android:id="@+id/tab_settings_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_settings"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
