<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/surface" />

    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/title_bar_height"
        android:background="@drawable/bg_title_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin_horizontal"
        android:paddingEnd="@dimen/space_2"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/IconButton"
            android:layout_marginEnd="4dp"
            android:contentDescription="返回设置总览"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/page_title"
                style="@style/Text.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings" />

            <TextView
                android:id="@+id/page_subtitle"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="状态、设备与连接"
                android:textColor="@color/text_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:minHeight="32dp"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="已停止"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin_horizontal"
            android:paddingEnd="@dimen/page_margin_horizontal"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_2">

            <!-- 设置总览 -->
            <LinearLayout
                android:id="@+id/page_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="运行状态"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overview_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="服务已停止"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overview_service"
                        style="@style/Text.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="HTTP 未启动 · BLE 未启用"
                        android:textColor="@color/text_secondary" />

                    <View style="@style/Divider" />

                    <TextView
                        android:id="@+id/tv_overview_device"
                        style="@style/Text.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="设备信息读取中…"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_overview_root"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Root 检测中…"
                        android:textColor="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_service_toggle"
                            style="@style/ButtonInlinePrimary"
                            android:text="启动服务" />

                        <Button
                            android:id="@+id/btn_test"
                            style="@style/ButtonInlineSecondary"
                            android:layout_marginStart="8dp"
                            android:text="测试连接" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_test_result"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/SectionTitle"
                    android:text="设置" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/row_connection"
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="连接与触发"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="HTTP、Token、蓝牙、回调与限流"
                                android:textColor="@color/text_hint" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            android:tint="@color/text_hint" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/row_voip"
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="来电与播报"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="联系人播报、声音与试听"
                                android:textColor="@color/text_hint" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            android:tint="@color/text_hint" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/row_device"
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="设备与诊断"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Root、保活权限与原始诊断"
                                android:textColor="@color/text_hint" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            android:tint="@color/text_hint" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/row_about"
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="关于与更新"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="版本、更新与项目主页"
                                android:textColor="@color/text_hint" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            android:tint="@color/text_hint" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 服务 -->
            <LinearLayout
                android:id="@+id/page_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp"
                    android:text="保活与权限" />

                <LinearLayout style="@style/Card">

                    <Switch
                        android:id="@+id/sw_watchdog"
                        style="@style/SwitchRow"
                        android:text="Root 看门狗"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="进程被杀后自动拉起，需要 Magisk / KernelSU / APatch" />

                    <TextView
                        android:id="@+id/tv_keepalive"
                        style="@style/ValueBox" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_battery"
                            style="@style/ButtonSecondary"
                            android:text="电池白名单" />

                        <Button
                            android:id="@+id/btn_autostart"
                            style="@style/ButtonSecondary"
                            android:layout_marginStart="10dp"
                            android:text="自启动设置" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_root"
                        style="@style/ButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_weight="0"
                        android:text="Root 检测" />

                    <TextView
                        android:id="@+id/tv_root_result"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                    <TextView
                        style="@style/RowCaption"
                        android:text="MIUI / HyperOS 建议将省电策略设为「无限制」" />
                </LinearLayout>
            </LinearLayout>

            <!-- 连接 -->
            <LinearLayout
                android:id="@+id/page_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp"
                    android:text="HTTP 与蓝牙" />

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="访问 Token"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_info"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="必填"
                            android:textColor="@color/info"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_token"
                        style="@style/ValueBox"
                        android:textIsSelectable="true" />

                    <TextView
                        style="@style/RowCaption"
                        android:text="HTTP、ContentProvider、蓝牙共用，重置后旧调用方立即失效" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_copy_token"
                            style="@style/ButtonSecondary"
                            android:text="复制 Token" />

                        <Button
                            android:id="@+id/btn_reset_token"
                            style="@style/ButtonSecondary"
                            android:layout_marginStart="10dp"
                            android:text="重置 Token" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputLabel"
                                android:text="监听地址" />

                            <EditText
                                android:id="@+id/et_bind"
                                style="@style/Input"
                                android:hint="0.0.0.0"
                                android:inputType="text" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputLabel"
                                android:text="端口" />

                            <EditText
                                android:id="@+id/et_port"
                                style="@style/Input"
                                android:hint="8790"
                                android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/RowCaption"
                        android:text="0.0.0.0 监听所有网卡；建议使用内网或 Tailscale 地址" />

                    <TextView
                        style="@style/InputLabel"
                        android:layout_marginTop="12dp"
                        android:text="来源 IP 白名单（可选）" />

                    <EditText
                        android:id="@+id/et_allowed_ips"
                        style="@style/Input"
                        android:hint="192.168.8.10, 192.168.8.0/24"
                        android:inputType="text" />

                    <TextView
                        style="@style/RowCaption"
                        android:text="留空允许所有来源；仍必须携带 Token" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <Switch
                        android:id="@+id/sw_bt"
                        style="@style/SwitchRow"
                        android:text="蓝牙触发（BLE）"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="Nordic UART Service；设备写入 JSON，每条指令需带 Token" />

                    <TextView
                        android:id="@+id/tv_bt_status"
                        style="@style/ValueBox" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bt_connected_devices"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_info"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="实时"
                            android:textColor="@color/info"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_bt_devices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_bt_devices_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_flat"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/bt_no_connected_devices"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_bt_uuid"
                            style="@style/ButtonSecondary"
                            android:text="复制 UUID" />

                        <Button
                            android:id="@+id/btn_bt_help"
                            style="@style/ButtonSecondary"
                            android:layout_marginStart="10dp"
                            android:text="协议说明" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 来电 -->
            <LinearLayout
                android:id="@+id/page_voip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp"
                    android:text="播报与声音" />

                <LinearLayout style="@style/Card">

                    <Switch
                        android:id="@+id/sw_voip_announce"
                        style="@style/SwitchRow"
                        android:text="播报联系人名字"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="用系统 TTS 播报「张三，微信视频来电」" />

                    <View style="@style/Divider" />

                    <Switch
                        android:id="@+id/sw_voip_sound"
                        style="@style/SwitchRow"
                        android:text="声音总开关"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="关闭后系统铃声最小并静音，不播报也不响铃" />

                    <TextView
                        android:id="@+id/tv_voip_status"
                        style="@style/ValueBox" />

                    <Button
                        android:id="@+id/btn_voip_test"
                        style="@style/ButtonSecondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp"
                        android:text="试听播报" />

                    <TextView
                        style="@style/RowCaption"
                        android:text="接听 POST /v1/answer · 查询 GET /v1/incoming" />
                </LinearLayout>
            </LinearLayout>

            <!-- 触发 -->
            <LinearLayout
                android:id="@+id/page_trigger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="触发与回调" />

                <LinearLayout style="@style/Card">

                    <Switch
                        android:id="@+id/sw_unlock"
                        style="@style/SwitchRow"
                        android:text="锁屏时自动唤醒并解锁"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/RowSubtitle"
                        android:text="仅支持滑动锁；密码、PIN、图案锁会返回 DEVICE_LOCKED" />

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputLabel"
                                android:text="每分钟最大请求数" />

                            <EditText
                                android:id="@+id/et_rate"
                                style="@style/Input"
                                android:hint="0"
                                android:inputType="number" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/InputLabel"
                                android:text="结果超时（秒）" />

                            <EditText
                                android:id="@+id/et_timeout"
                                style="@style/Input"
                                android:hint="30"
                                android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/RowCaption"
                        android:text="限流填 0 表示不限；超时后状态变为 FAILED / TIMEOUT" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="回调与白名单（可选）"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/InputLabel"
                        android:layout_marginTop="14dp"
                        android:text="回调域名" />

                    <EditText
                        android:id="@+id/et_callback"
                        style="@style/Input"
                        android:hint="example.com，逗号分隔"
                        android:inputType="text"
                        android:maxLines="2" />

                    <TextView
                        style="@style/RowCaption"
                        android:text="留空只支持轮询；回调签名 X-Xp-Signature: sha256=HMAC(请求体, Token)" />

                    <TextView
                        style="@style/InputLabel"
                        android:layout_marginTop="14dp"
                        android:text="Provider 包名白名单" />

                    <EditText
                        android:id="@+id/et_packages"
                        style="@style/Input"
                        android:hint="com.example.app，逗号分隔"
                        android:inputType="text"
                        android:maxLines="2" />

                    <TextView
                        style="@style/RowCaption"
                        android:text="留空只校验 Token；HTTP 接口不受影响" />
                </LinearLayout>
            </LinearLayout>

            <!-- 诊断 -->
            <LinearLayout
                android:id="@+id/page_diagnostic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp"
                    android:text="运行诊断" />

                <LinearLayout style="@style/Card">

                    <TextView
                        android:id="@+id/tv_diag_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="正在读取…"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_diag_refresh"
                            style="@style/ButtonSecondary"
                            android:text="刷新" />

                        <Button
                            android:id="@+id/btn_diag_copy"
                            style="@style/ButtonSecondary"
                            android:layout_marginStart="10dp"
                            android:text="复制诊断" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_diag_expand"
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_list_item_selector"
                        android:clickable="true"
                        android:contentDescription="展开原始诊断"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="原始诊断（展开）"
                        android:textColor="@color/primary" />

                    <TextView
                        android:id="@+id/tv_diag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:text="正在读取…"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 关于 -->
            <LinearLayout
                android:id="@+id/page_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp"
                    android:text="应用信息" />

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_update_version"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/update_current_version"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_info"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="GitHub"
                            android:textColor="@color/info"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_update_status"
                        style="@style/RowSubtitle"
                        android:layout_marginTop="6dp"
                        android:text="@string/update_status_idle" />

                    <ProgressBar
                        android:id="@+id/pb_update"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progressTint="@color/primary"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_update"
                            style="@style/ButtonPrimary"
                            android:text="@string/update_action_check" />

                        <Button
                            android:id="@+id/btn_update_page"
                            style="@style/ButtonSecondary"
                            android:layout_marginStart="10dp"
                            android:text="@string/update_action_page" />
                    </LinearLayout>

                    <TextView
                        style="@style/RowCaption"
                        android:text="下载后校验包名、版本与签名；安装后需重启微信" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:id="@+id/btn_hint_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_min"
                        android:orientation="horizontal"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HTTP / BLE 调用示例"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_hint_toggle_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_info"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="展开"
                            android:textColor="@color/info"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card_flat"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:padding="14dp"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_action"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin_horizontal"
        android:paddingEnd="@dimen/page_margin_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_unsaved"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="有未保存改动"
            android:textColor="@color/text_hint"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_save"
            style="@style/ButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="已保存" />
    </LinearLayout>

    <include
        android:id="@+id/tab_bar"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height" />
</LinearLayout>
